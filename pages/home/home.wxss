.hero {
  position: relative;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2f6bff, #4f8bff);
  color: #fff;
  margin-bottom: 24rpx;
}

/* 管理员：右上角的视图切换下拉菜单（轻量浮层，不新开页面） */
.hero-switch {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  color: #fff;
}

.hero-caret {
  font-size: 22rpx;
  line-height: 1;
  transition: transform 0.15s;
}

.hero-caret.up {
  transform: rotate(180deg);
}

.hero-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.hero-menu {
  position: absolute;
  right: 24rpx;
  top: 88rpx;
  z-index: 12;
  width: 320rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(15, 30, 70, 0.22);
}

.hero-menu-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: #1a2233;
}

.hero-menu-item.on {
  background: #eef3ff;
}

.hero-menu-title {
  font-size: 28rpx;
  font-weight: 600;
}

.hero-menu-item.on .hero-menu-title {
  color: #2f6bff;
}

.hero-menu-tip {
  font-size: 22rpx;
  color: #8a94a6;
}

.hero-row {
  display: flex;
  align-items: center;
}

/* 右上角有切换按钮时，给姓名行让出位置，避免长名字被遮挡 */
.hero.has-switch .hero-row {
  padding-right: 150rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
}

.role-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  font-size: 22rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-id {
  margin-top: 20rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.seat-hero {
  padding: 20rpx 0;
}

.seat-code {
  font-size: 52rpx;
  font-weight: 700;
}

.seat-zone {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}



.no-seat {
  padding: 20rpx 0;
  text-align: center;
}

.no-seat-text {
  font-size: 26rpx;
  color: var(--text-weak);
}

.quick {
  display: flex;
}

.quick-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
}

.qi-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 22rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}
.qi-icon.blue { background: #2f6bff; }
.qi-icon.green { background: #17b26a; }
.qi-icon.purple { background: #7a5af8; }

.stat-grid {
  display: flex;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

.rate-bar {
  height: 12rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  overflow: hidden;
}

.rate-inner {
  height: 100%;
  background: var(--primary);
  border-radius: 999rpx;
}

.btn-mini {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}
.btn-mini.ghost {
  background: var(--primary-light);
  color: var(--primary);
}
.btn-mini.plain {
  background: #f2f4f8;
  color: var(--text-weak);
}

.checkin-status {
  font-size: 32rpx;
  font-weight: 600;
}
.checkin-status.done {
  color: var(--success);
}

.todo {
  display: flex;
  align-items: center;
}

.todo-badge {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.notice {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--line);
}
.notice:first-child {
  border-top: none;
}
.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin: 14rpx 16rpx 0 0;
}
.notice-title {
  font-size: 28rpx;
  line-height: 1.5;
}
