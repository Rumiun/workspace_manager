.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #6b7688;
  border-radius: 12rpx;
}
.tab.active {
  background: #2f6bff;
  color: #fff;
  font-weight: 600;
}
.kv {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-top: 2rpx solid #f5f7fa;
}
.reason, .comment {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #6b7688;
  line-height: 1.6;
}
.comment {
  background: #eaf0ff;
  color: #2f6bff;
}
.btns {
  display: flex;
  margin-top: 24rpx;
}
.btns .btn {
  margin-left: 16rpx;
  height: 80rpx;
}
.btns .btn:first-child {
  margin-left: 0;
}

.batch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.btn-mini {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}
