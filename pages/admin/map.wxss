/* 工位地图编辑器 */

.map-card {
  position: relative;
}

/* 画布：图片按宽度铺满，工位按钮用百分比定位，换屏幕不会错位 */
.map-canvas {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f7f9fc;
  border: 2rpx dashed #d6deeb;
  box-sizing: border-box;
}

.map-canvas:active {
  border-color: #b9c7de;
}

.map-img {
  display: block;
  width: 100%;
}

.map-empty {
  padding: 160rpx 40rpx;
  text-align: center;
}

.map-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #667085;
  margin-bottom: 12rpx;
}

.map-empty-desc {
  font-size: 24rpx;
  color: #98a2b3;
  line-height: 1.6;
}

/* 工位按钮 */
.map-point {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #2f6bff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(47, 107, 255, 0.35);
  border: 3rpx solid #fff;
}

.map-point.on {
  background: #f79009;
  box-shadow: 0 6rpx 18rpx rgba(247, 144, 9, 0.45);
  z-index: 2;
}

/* 右侧设置列 */
.map-side {
  min-width: 0;
}

.bg-row {
  display: flex;
  align-items: center;
}

.bg-thumb {
  width: 120rpx;
  height: 90rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f2f4f8;
  margin-right: 20rpx;
  flex: none;
}

.bg-thumb image {
  width: 100%;
  height: 100%;
}

.bg-info {
  flex: 1;
  min-width: 0;
}

.bg-name {
  font-size: 26rpx;
  color: #344054;
  margin-bottom: 6rpx;
  word-break: break-all;
}

/* 电脑版：画布占 2/3，设置列占 1/3 */
.page.pc .cols > .map-card {
  flex: 2;
  min-width: 0;
}

.page.pc .cols > .map-side {
  flex: 1;
  min-width: 0;
}

.page.pc .map-point {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
}

/* 数据来源提示：服务端 / 本机缓存 */
.map-src {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px dashed #e8ecf3;
}

.map-src .text-weak {
  flex: 1;
  min-width: 0;
}
