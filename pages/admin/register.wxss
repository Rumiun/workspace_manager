.picker-line {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  background: #f2f4f8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.batch {
  padding: 20rpx 0;
  border-top: 1rpx solid #eef1f6;
}

.batch:first-of-type {
  border-top: none;
}
