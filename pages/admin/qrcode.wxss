.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #f2f4f8;
  color: var(--text-sub);
  font-size: 24rpx;
}

.chip.on {
  background: var(--primary-light);
  color: var(--primary);
}

.swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 2rpx solid #e3e8f0;
  margin-right: 10rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.txt-input {
  height: 76rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  background: #f2f4f8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text);
}

.canvas-box {
  width: 100%;
  white-space: nowrap;
  border-radius: 12rpx;
}

.canvas-box canvas {
  display: inline-block;
}

.pager {
  display: flex;
  margin-top: 20rpx;
}

.pager .btn.grow {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.pager .btn.grow:first-child {
  margin-right: 16rpx;
}
