.form-item {
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
}

.form-row .form-item.grow {
  flex: 1;
  margin-right: 12rpx;
}

.form-row .form-item.grow:last-child {
  margin-right: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #f2f4f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.ops {
  display: flex;
  flex-wrap: wrap;
}

.op {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  background: #f2f4f8;
  color: var(--text-sub);
  font-size: 24rpx;
}

.op.primary {
  background: var(--primary-light);
  color: var(--primary);
}

.op.danger {
  background: var(--danger-light);
  color: var(--danger);
}

/* 布局方式：标准网格 / 自定义地图 */
.mode-chips {
  display: flex;
  flex-wrap: wrap;
}

.mode-chip {
  padding: 10rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #f2f4f8;
  color: var(--text-sub);
  font-size: 24rpx;
  border: 2rpx solid transparent;
}

.mode-chip.on {
  background: #eaf0ff;
  color: #2f6bff;
  border-color: #2f6bff;
  font-weight: 600;
}

.mode-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.mode-row .small {
  margin-right: 16rpx;
  flex: none;
}
