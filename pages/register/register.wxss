.search {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f2f4f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
}

.seat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.seat-code {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.seat-zone {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
}

.tip {
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.tip.success { background: var(--success-light); color: var(--success); }
.tip.primary { background: var(--primary-light); color: var(--primary); }
.tip.warning { background: var(--warning-light); color: var(--warning); }
.tip.danger { background: var(--danger-light); color: var(--danger); }

.log {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}
.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  margin: 12rpx 16rpx 0 0;
}

.scan-guide {
  padding: 60rpx 0;
  text-align: center;
}
.scan-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 48rpx;
  font-weight: 600;
}

.footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f2f4f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}

.ops {
  display: flex;
  flex-wrap: wrap;
}

.op {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  background: #f2f4f8;
  color: var(--text-sub);
  font-size: 24rpx;
}
