<pc-shell nav="mine" title="个人中心">
<view class="page {{isWide ? 'pc' : ''}}">
  <view class="card">
    <view class="card-title">个人信息</view>
    <view class="kv">
      <text class="text-sub">{{isAdmin ? '工号' : '学号'}}</text>
      <text>{{user.id}}</text>
    </view>
    <view class="kv">
      <text class="text-sub">姓名</text>
      <text>{{user.name}}</text>
    </view>
    <view class="kv">
      <text class="text-sub">单位</text>
      <text>{{user.college}}</text>
    </view>
    <view class="kv" wx:if="{{!isAdmin}}">
      <text class="text-sub">导师</text>
      <text>{{user.tutor}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">工位</view>
    <view class="kv" bindtap="goRegister">
      <text class="text-sub">工位登记 / 变更</text>
      <text class="more">扫码登记 ›</text>
    </view>
  </view>

  <view class="btn block danger" bindtap="logout">退出登录</view>
</view>
</pc-shell>
