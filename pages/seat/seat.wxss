.seat-page {
  padding-top: 20rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  height: 80rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 80rpx;
}
.search-clear {
  font-size: 24rpx;
  color: #2f6bff;
}
.zone-tabs {
  display: flex;
  margin-bottom: 20rpx;
}
.zone-tab {
  flex: 1;
  margin-right: 16rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: #fff;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: #6b7688;
}
.zone-tab:last-child {
  margin-right: 0;
}
.zone-tab.active {
  background: #2f6bff;
  color: #fff;
  font-weight: 600;
}
.legend {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.lg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7688;
}
.lg-box {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}
.lg-box.free { background: #e6f7ee; border: 2rpx solid #17b26a; }
.lg-box.used { background: #eef1f6; border: 2rpx solid #c6cddb; }
.lg-box.mine { background: #eaf0ff; border: 2rpx solid #2f6bff; }
.lg-box.repair { background: #fdeceb; border: 2rpx solid #f04438; }

.zone-block {
  margin-bottom: 32rpx;
}
.zone-block:last-child {
  margin-bottom: 0;
}
.zone-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.seat-row {
  display: flex;
  margin-bottom: 12rpx;
}
.seat {
  flex: 1;
  margin-right: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #6b7688;
  background: #eef1f6;
  border: 2rpx solid #eef1f6;
}
.seat:last-child {
  margin-right: 0;
}
.seat.free {
  background: #e6f7ee;
  border-color: #a9e3c6;
  color: #17b26a;
}
.seat.mine {
  background: #eaf0ff;
  border-color: #2f6bff;
  color: #2f6bff;
  font-weight: 600;
}
.seat.repair {
  background: #fdeceb;
  border-color: #f7b5ae;
  color: #f04438;
}
.tip {
  font-size: 22rpx;
  color: #9aa4b5;
  text-align: center;
  padding: 8rpx 0 40rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sheet-code {
  max-width: 70%;
  font-size: 44rpx;
  font-weight: 700;
  color: #2f6bff;
  word-break: break-all;
}

.sheet-code.long {
  font-size: 32rpx;
}
.sheet .kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-top: 2rpx solid #f5f7fa;
}

/* 自定义布局：照片 + 百分比定位的工位按钮 */
.map-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
  background: #f7f9fc;
}

.map-img {
  display: block;
  width: 100%;
}

.map-seat {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  color: #fff;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 39, 75, 0.18);
}

.map-seat.free { background: #17b26a; }
.map-seat.used { background: #98a2b3; }
.map-seat.mine { background: #2f6bff; }
.map-seat.repair { background: #f04438; }
